POSTGRES_USER=cengello
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cengello

JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ACCESS_TTL_MIN=20
JWT_REFRESH_TTL_DAYS=30

# false for local http dev, true (default) in production behind HTTPS
COOKIE_SECURE=true

NEXT_PUBLIC_API_URL=http://localhost:8000

# prod only (docker-compose.prod.yml + Caddy)
DOMAIN=example.com

# Optional: only needed if the defaults (5432/8000/3000) are already taken
# on your machine or shared host -- e.g. another Postgres install, or a
# second project on the same VPS. All three default to the standard port
# if unset, and are always bound to 127.0.0.1 only.
# POSTGRES_HOST_PORT=5432
# BACKEND_HOST_PORT=8000
# FRONTEND_HOST_PORT=3000
